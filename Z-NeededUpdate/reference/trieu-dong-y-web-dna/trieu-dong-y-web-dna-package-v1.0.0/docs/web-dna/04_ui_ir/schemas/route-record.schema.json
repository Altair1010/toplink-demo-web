{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trieu-dong-y-web-dna.local/schemas/route-record.schema.json",
  "title": "Web DNA Route Record",
  "type": "object",
  "required": ["route_id", "url", "path", "status", "archetype", "priority", "evidence_method"],
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "path": {"type": "string", "pattern": "^/"},
    "status": {"enum": ["captured", "discovered", "failed"]},
    "archetype": {"type": "string", "minLength": 1},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "title": {"type": ["string", "null"]},
    "h1": {
      "type": "array",
      "items": {"type": "string"}
    },
    "canonical": {"type": ["string", "null"]},
    "discovered_from": {
      "type": "array",
      "items": {"type": "string", "format": "uri"}
    },
    "evidence_method": {"type": "string", "minLength": 1},
    "captured_at": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
