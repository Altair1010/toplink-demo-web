# Public content transport; server-side only.
TOPLINK_CMS_BASE_URL=http://127.0.0.1:8085/wp-json/toplink/v1
TOPLINK_WEB_BASE_URL=http://127.0.0.1:3000/
TOPLINK_PUBLIC_SITE_URL=http://127.0.0.1:3000/

# Keep disabled for local/preview/staging. Enable only with an approved HTTPS production origin.
TOPLINK_INDEXING_ENABLED=0

# Generate unique local values. Never prefix these with NEXT_PUBLIC.
TOPLINK_WEBHOOK_SECRET=GENERATE_A_LOCAL_SECRET
TOPLINK_PREVIEW_SECRET=GENERATE_A_DIFFERENT_LOCAL_SECRET
