# Copy to .env or run scripts/bootstrap.ps1 to generate local-only credentials.
TOPLINK_WP_PORT=8085
TOPLINK_DB_NAME=toplink_p5
TOPLINK_DB_USER=toplink_p5
TOPLINK_DB_PASSWORD=GENERATE_A_LOCAL_SECRET
TOPLINK_DB_ROOT_PASSWORD=GENERATE_A_DIFFERENT_LOCAL_SECRET
TOPLINK_WP_ADMIN_USER=toplink_admin
TOPLINK_WP_ADMIN_PASSWORD=GENERATE_A_LOCAL_SECRET
TOPLINK_WP_ADMIN_EMAIL=admin@toplink.invalid
TOPLINK_WP_AUTHOR_USER=p5_author
TOPLINK_WP_AUTHOR_PASSWORD=GENERATE_A_LOCAL_SECRET
TOPLINK_WP_EDITOR_USER=p5_editor
TOPLINK_WP_EDITOR_PASSWORD=GENERATE_A_LOCAL_SECRET

# P6 local-only integration. Shared values must match web/.env.local.
TOPLINK_WEBHOOK_URL=http://host.docker.internal:3000/api/cms/revalidate
TOPLINK_WEBHOOK_SECRET=GENERATE_A_LOCAL_SECRET
TOPLINK_PREVIEW_SECRET=GENERATE_A_DIFFERENT_LOCAL_SECRET
TOPLINK_PREVIEW_WEB_URL=http://127.0.0.1:3000/api/cms/preview
