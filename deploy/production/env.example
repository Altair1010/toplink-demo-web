# Copy to .env on the target server, chmod 600, then replace every REPLACE_ON_SERVER value.
TOPLINK_DEPLOY_SHA=298b9c3834df926b243c800cba66cf6466d950e5
TOPLINK_PUBLIC_HOST=frontend.example.invalid
TOPLINK_CMS_HOST=cms.example.invalid
TOPLINK_PUBLIC_SITE_URL=https://frontend.example.invalid
TOPLINK_CMS_BASE_URL=https://cms.example.invalid/wp-json/toplink/v1
TOPLINK_ACME_EMAIL=REPLACE_ON_SERVER

TOPLINK_DB_NAME=toplink
TOPLINK_DB_USER=toplink_app
TOPLINK_DB_PASSWORD=REPLACE_ON_SERVER_WITH_RANDOM_VALUE
TOPLINK_DB_ROOT_PASSWORD=REPLACE_ON_SERVER_WITH_DIFFERENT_RANDOM_VALUE

TOPLINK_WEBHOOK_URL=https://frontend.example.invalid/api/cms/revalidate
TOPLINK_WEBHOOK_SECRET=REPLACE_ON_SERVER_WITH_64_HEX
TOPLINK_PREVIEW_WEB_URL=https://frontend.example.invalid/api/cms/preview
TOPLINK_PREVIEW_SECRET=REPLACE_ON_SERVER_WITH_DIFFERENT_64_HEX
