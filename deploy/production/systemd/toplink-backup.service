[Unit]
Description=Toplink production database and uploads backup
Requires=docker.service
After=docker.service
ConditionPathExists=/srv/toplink/deploy/production/.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/toplink/deploy/production
ExecStart=/srv/toplink/deploy/production/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
